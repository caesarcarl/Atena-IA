{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atena.local/schema/knowledge-pack.schema.json",
  "title": "Atena Knowledge Pack",
  "type": "object",
  "required": ["schema_version", "id", "version", "display_name", "description", "audience", "languages", "dependencies", "domains", "retrieval", "distribution", "sources"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^atena\\.[a-z0-9._-]+$"},
    "version": {"type": "string"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "audience": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "languages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "domains": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "retrieval": {
      "type": "object",
      "required": ["priority", "default_max_hits"],
      "properties": {
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "default_max_hits": {"type": "integer", "minimum": 1, "maximum": 12}
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["bundled_in_demo", "optional"],
      "properties": {
        "bundled_in_demo": {"type": "boolean"},
        "optional": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sources": {"type": "array"}
  },
  "additionalProperties": false
}
