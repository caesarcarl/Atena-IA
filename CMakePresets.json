{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-gcc-debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ATENA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-gcc-asan",
      "inherits": "linux-gcc-debug",
      "binaryDir": "${sourceDir}/build/linux-gcc-asan",
      "cacheVariables": {
        "ATENA_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug"},
    {"name": "linux-gcc-asan", "configurePreset": "linux-gcc-asan"}
  ],
  "testPresets": [
    {"name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "output": {"outputOnFailure": true}},
    {"name": "linux-gcc-asan", "configurePreset": "linux-gcc-asan", "output": {"outputOnFailure": true}}
  ]
}
