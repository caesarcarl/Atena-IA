cmake_minimum_required(VERSION 3.20)
project(Atena VERSION 0.5.2 LANGUAGES C CXX)

set(CMAKE_C_STANDARD 17)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

if(NOT WIN32)
  add_compile_definitions(_POSIX_C_SOURCE=200809L)
endif()

option(ATENA_BUILD_TESTS "Compilar testes" ON)
option(ATENA_BUILD_UI "Compilar interface Qt 6 quando disponível" ON)
option(ATENA_REQUIRE_UI "Falhar a configuração se ATENA_BUILD_UI=ON e Qt 6 não estiver disponível" OFF)
set(ATENA_PACKAGE_REVISION "0.5.13-memory-first" CACHE STRING "Revisão do pacote/distribuição da Atena")
add_compile_definitions(ATENA_PACKAGE_REVISION="${ATENA_PACKAGE_REVISION}")
option(ATENA_ENABLE_ASAN "Ativar AddressSanitizer" OFF)
option(ATENA_MOBILE "Build enxuto para Android/Kali/NetHunter sem worker Python" OFF)
option(ATENA_ENABLE_PYTHON_WORKER "Habilitar integração opcional com worker Python no desktop" ON)
if(ATENA_MOBILE)
  set(ATENA_ENABLE_PYTHON_WORKER OFF CACHE BOOL "" FORCE)
endif()

include(GNUInstallDirs)

if(WIN32)
  find_package(unofficial-sqlite3 CONFIG REQUIRED)
  find_package(json-c CONFIG REQUIRED)
  set(ATENA_SQLITE_TARGET unofficial::sqlite3::sqlite3)
  set(ATENA_JSON_TARGET json-c::json-c)
else()
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(SQLITE3 REQUIRED IMPORTED_TARGET sqlite3)
  pkg_check_modules(JSONC REQUIRED IMPORTED_TARGET json-c)
  pkg_check_modules(LIBCURL REQUIRED IMPORTED_TARGET libcurl)
  pkg_check_modules(LIBSECRET QUIET IMPORTED_TARGET libsecret-1)
  set(ATENA_SQLITE_TARGET PkgConfig::SQLITE3)
  set(ATENA_JSON_TARGET PkgConfig::JSONC)
  set(ATENA_CURL_TARGET PkgConfig::LIBCURL)
endif()

if(WIN32)
  find_package(CURL REQUIRED)
  set(ATENA_CURL_TARGET CURL::libcurl)
endif()
find_package(OpenSSL REQUIRED)
find_package(Threads REQUIRED)

if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
  add_compile_options(-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wformat=2)
  if(ATENA_ENABLE_ASAN)
    add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer)
    add_link_options(-fsanitize=address,undefined)
  endif()
elseif(MSVC)
  add_compile_options(/W4)
  add_compile_definitions(_CRT_SECURE_NO_WARNINGS)
endif()

set(ATENA_INSTALLED_DATA_DIR "${CMAKE_INSTALL_FULL_DATADIR}/atena")
set(ATENA_INSTALLED_LIBEXEC_DIR "${CMAKE_INSTALL_FULL_LIBEXECDIR}/atena")

add_library(atena_runtime STATIC runtime/runtime.cpp)
target_include_directories(atena_runtime PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)

add_library(atena_platform STATIC platform/paths.c platform/process.c platform/secrets.c platform/sync.c platform/transport_unix.c platform/transport_win32.c)
target_include_directories(atena_platform PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_definitions(atena_platform PRIVATE ATENA_DATA_DIR="${ATENA_INSTALLED_DATA_DIR}" ATENA_LIBEXEC_DIR="${ATENA_INSTALLED_LIBEXEC_DIR}")
if(WIN32)
  target_link_libraries(atena_platform PUBLIC shell32 ole32 advapi32 bcrypt)
elseif(LIBSECRET_FOUND)
  target_compile_definitions(atena_platform PRIVATE ATENA_HAVE_LIBSECRET=1)
  target_link_libraries(atena_platform PUBLIC PkgConfig::LIBSECRET)
endif()

add_library(atena_core STATIC core/status.c core/util.c core/context.c core/core.c memory/store.c providers/mock_provider.c providers/ollama/ollama_provider.c providers/openai_compatible/openai_compatible_provider.c tools/tools.c)
target_include_directories(atena_core PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(atena_core PUBLIC ${ATENA_SQLITE_TARGET} ${ATENA_JSON_TARGET} ${ATENA_CURL_TARGET} OpenSSL::Crypto Threads::Threads atena_platform atena_runtime)
if(WIN32)
  target_link_libraries(atena_core PUBLIC bcrypt)
endif()

add_library(atena_protocol STATIC ipc/protocol.c core/util.c core/status.c)
target_include_directories(atena_protocol PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(atena_protocol PUBLIC atena_platform)

if(WIN32)
  add_library(atena_ipc_server STATIC ipc/server_win32.c ipc/server_dispatch.c)
else()
  add_library(atena_ipc_server STATIC ipc/server.c ipc/server_dispatch.c)
endif()
target_include_directories(atena_ipc_server PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(atena_ipc_server PUBLIC atena_core atena_protocol ${ATENA_JSON_TARGET} Threads::Threads)
if(WIN32)
  target_link_libraries(atena_ipc_server PUBLIC advapi32)
endif()

add_library(atena_client STATIC sdk/client.c)
target_include_directories(atena_client PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(atena_client PUBLIC atena_platform atena_protocol ${ATENA_JSON_TARGET} Threads::Threads)

# ============================================================
# Executáveis principais
# ============================================================

add_executable(atena-core
    services/main.c
)

target_link_libraries(atena-core
    PRIVATE
        atena_ipc_server
        atena_platform
)

add_executable(atena
    cli/main.c
)

target_link_libraries(atena
    PRIVATE
        atena_client
        ${ATENA_JSON_TARGET}
)
if(ATENA_ENABLE_PYTHON_WORKER)
  target_compile_definitions(atena PRIVATE ATENA_ENABLE_PYTHON_WORKER=1)
endif()

# ============================================================
# Runtime local de desenvolvimento
#
# A CLI usa o SDK, que pode iniciar o Atena Core automaticamente.
# Para isso, Core e identity precisam estar disponíveis junto do
# executável durante uma build local, sem depender de /usr.
# ============================================================

add_dependencies(atena atena-core)

add_custom_command(
    TARGET atena
    POST_BUILD

    COMMAND ${CMAKE_COMMAND} -E copy_if_different
        $<TARGET_FILE:atena-core>
        $<TARGET_FILE_DIR:atena>/$<TARGET_FILE_NAME:atena-core>

    COMMAND ${CMAKE_COMMAND} -E copy_directory
        ${CMAKE_SOURCE_DIR}/identity
        $<TARGET_FILE_DIR:atena>/identity

    COMMENT "Staging Atena Core and identity beside the CLI"
    VERBATIM
)

if(ATENA_BUILD_UI)
  include(CheckLanguage)
  check_language(CXX)
  if(CMAKE_CXX_COMPILER)
    enable_language(CXX)
    find_package(Qt6 6.4 QUIET COMPONENTS Widgets Svg)
    if(Qt6_FOUND)
      set(ATENA_UI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
      add_subdirectory(ui/qt)
    elseif(ATENA_REQUIRE_UI)
      message(FATAL_ERROR "Qt 6.4+ (Widgets e Svg) é obrigatório para esta instalação da Atena.")
    else()
      message(STATUS "Qt 6 não encontrado: Core e CLI serão compilados sem a interface gráfica.")
    endif()
  endif()
endif()

install(TARGETS atena RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT Runtime)
if(WIN32)
  install(TARGETS atena-core RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT Runtime)
else()
  install(TARGETS atena-core RUNTIME DESTINATION ${CMAKE_INSTALL_LIBEXECDIR}/atena COMPONENT Runtime)
endif()
if(TARGET atena-ui)
  install(TARGETS atena-ui RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT Runtime)
endif()

if(WIN32)
  install(DIRECTORY identity/ DESTINATION ${CMAKE_INSTALL_BINDIR}/identity COMPONENT Runtime)
else()
  install(DIRECTORY identity/ DESTINATION ${CMAKE_INSTALL_DATADIR}/atena/identity COMPONENT Runtime)
  if(ATENA_ENABLE_PYTHON_WORKER)
    install(DIRECTORY python/atena_worker/ DESTINATION ${CMAKE_INSTALL_LIBDIR}/atena/python/atena_worker COMPONENT Runtime)
  endif()
  install(FILES packaging/linux/atena.desktop DESTINATION ${CMAKE_INSTALL_DATADIR}/applications COMPONENT Runtime)

  foreach(ATENA_ICON_SIZE IN ITEMS 16 24 32 48 64 96 128 256 512)
    install(FILES ui/qt/resources/branding/app-icon/atena-${ATENA_ICON_SIZE}x${ATENA_ICON_SIZE}.png
            DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/${ATENA_ICON_SIZE}x${ATENA_ICON_SIZE}/apps
            RENAME atena.png COMPONENT Runtime)
  endforeach()

  # Keep a raw copy for diagnostics, future integrations and external launchers.
  install(DIRECTORY ui/qt/resources/branding/
          DESTINATION ${CMAKE_INSTALL_DATADIR}/atena/assets/branding COMPONENT Runtime)
  install(DIRECTORY ui/qt/resources/icons/navigation/
          DESTINATION ${CMAKE_INSTALL_DATADIR}/atena/assets/icons/navigation COMPONENT Runtime)
  install(DIRECTORY ui/qt/resources/icons/quick-actions/
          DESTINATION ${CMAKE_INSTALL_DATADIR}/atena/assets/icons/quick-actions COMPONENT Runtime)
  install(DIRECTORY ui/qt/resources/illustrations/
          DESTINATION ${CMAKE_INSTALL_DATADIR}/atena/assets/illustrations COMPONENT Runtime)

  configure_file(packaging/systemd/atena-core.service.in ${CMAKE_CURRENT_BINARY_DIR}/atena-core.service @ONLY)
  install(FILES ${CMAKE_CURRENT_BINARY_DIR}/atena-core.service DESTINATION ${CMAKE_INSTALL_LIBDIR}/systemd/user COMPONENT Runtime)
endif()

if(ATENA_BUILD_TESTS AND NOT WIN32)
  enable_testing()
  foreach(test_name IN ITEMS test_core test_persistence test_migration_legacy test_migration_intermediate test_migration_constraints test_rag test_ipc_sdk test_tools test_protocol test_runtime)
    add_executable(${test_name} tests/${test_name}.c)
    target_link_libraries(${test_name} PRIVATE atena_core atena_ipc_server atena_client)
    add_test(NAME ${test_name} COMMAND ${test_name})
    set_tests_properties(${test_name} PROPERTIES WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})
  endforeach()
endif()

set(CPACK_PACKAGE_NAME "atena")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_CONTACT "Projeto Athenas OS")
if(WIN32)
  set(CPACK_GENERATOR "ZIP")
else()
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_SUGGESTS "ollama")
  set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
  set(CPACK_GENERATOR "DEB;TGZ")
endif()
include(CPack)
